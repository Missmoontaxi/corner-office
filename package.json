{
  "name": "corner-office",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "seed:check": "node scripts/check-seed.mjs",
    "seed:import": "python3 scripts/seed_from_sheet.py",
    "graybox": "node scripts/graybox.mjs ../art/graybox",
    "test:viewport": "playwright test",
    "check:direct": "node scripts/check-direct-models.mjs",
    "check:mcp": "node scripts/check-mcp.mjs",
    "graybox:wide": "node scripts/graybox-wide.mjs ../art/graybox",
    "art:build": "node scripts/art-build.mjs",
    "art:wall": "node scripts/art-wall.mjs",
    "brief": "tsx --env-file-if-exists=.env.local scripts/brief.ts",
    "asks": "tsx --env-file-if-exists=.env.local scripts/asks.ts",
    "precompute": "tsx --env-file-if-exists=.env.local scripts/precompute.ts",
    "owner:link": "tsx scripts/owner-link.ts",
    "kill": "tsx --env-file-if-exists=.env.local scripts/kill.ts",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval-run.ts",
    "eval:full": "tsx --env-file-if-exists=.env.local scripts/eval-run.ts --full",
    "eval:view": "tsx scripts/eval-view.ts",
    "eval:pull": "tsx scripts/eval-pull.ts",
    "eval:fixtures": "tsx --env-file-if-exists=.env.local scripts/eval-fixtures.ts",
    "eval:check-days": "tsx scripts/eval-check-days.ts",
    "eval:sheet": "tsx scripts/eval-day-sheet.ts",
    "eval:scorecard": "tsx scripts/eval-scorecard.ts",
    "guard:screen": "tsx --env-file-if-exists=.env.local scripts/guard-screen.ts",
    "guard:replay": "tsx --env-file-if-exists=.env.local scripts/guard-replay.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.68",
    "@ai-sdk/gateway": "4.0.100",
    "@ai-sdk/openai": "4.0.81",
    "@modelcontextprotocol/server": "2.2.0",
    "@vercel/blob": "2.8.0",
    "ai": "7.0.122",
    "mcp-handler": "2.2.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "promptfoo": "0.123.1",
    "sharp": "0.34.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
