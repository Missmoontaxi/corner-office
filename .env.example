# Copy to .env.local and fill in locally. Never commit real values.
# The app reaches AI Gateway through Vercel OIDC, so no model key lives here in production.
AI_GATEWAY_API_KEY=        # dev key only ($10 budget, 30-day expiry)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LINK_SECRET=               # made by pnpm link:secret, 32+ characters
