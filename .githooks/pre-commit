#!/bin/sh
# Blocks any commit that contains a secret. Install gitleaks with `brew install gitleaks`.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed. Run: brew install gitleaks" >&2
  exit 1
fi
gitleaks git --staged --redact --no-banner || {
  echo "Commit blocked: gitleaks found what looks like a secret." >&2
  exit 1
}
